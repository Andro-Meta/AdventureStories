# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# Virtual environments
venv_local_ai/
venv/
.venv/

# Local AI model weights (large; download via setup_local_ai.py)
models/
*.gguf
*.bin
*.safetensors

# llama.cpp binaries (download from upstream; OS-specific)
llama-cpp/

# Node (future React Native port)
node_modules/
package-lock.json
yarn.lock
.pnp/
.pnp.js

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs / runtime artifacts
*.log
*.pid
.cache/

# Build artifacts
dist/
build/
*.tgz

# Save files (browser localStorage usually, but in case any leak to disk)
advStorySave_*
*.save

# Editor scratch
*.bak
*.orig

# Local secrets baked into APK at build time but never committed.
# Create mobile/local-secrets.json with {"openrouterApiKey": "sk-or-v1-..."}
mobile/local-secrets.json
mobile/www/mobile-bootstrap.js
mobile/android/app/src/main/assets/public/mobile-bootstrap.js

# On-device model files (1.6 GB) and Capacitor-generated web assets: never commit
*.task
mobile/android/app/src/main/assets/

# Local secrets (OpenRouter key for dev tests) - never commit
.env
mobile/offline-models/
# Built APKs are artifacts, not source
*.apk

# Local test output (screenshots, phone save backups, story dumps): never publish
test-results/*
!test-results/.last-run.json
