{
  "appId": "com.androsmeta.adventurestories",
  "appName": "Talewright Adventures",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "minWebViewVersion": 60,
    "allowMixedContent": false,
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystoreAlias": "adventure-stories",
      "releaseType": "AAB"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#ff9a76",
      "showSpinner": false,
      "spinnerColor": "#FFD700"
    },
    "SystemBars": {
      "style": "DARK"
    }
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  }
}
